        <mxCell id="titleBanner" value="&lt;b style='font-size:18px;color:#0F172A;'&gt;CareerPilot: Multi-Agent Architecture &amp;amp; Workflow&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:11px;color:#64748B;'&gt;Stateful 5-Agent Copilot with Human-in-the-Loop (HITL) Safety Gate | Powered by LangGraph, Playwright, &amp;amp; Vector Benchmarking&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F8FAFC;strokeColor=#CBD5E1;strokeWidth=1.5;align=center;verticalAlign=middle;shadow=1;" vertex="1" parent="1">
