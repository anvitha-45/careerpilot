        <!-- Architecture Highlights Card -->
        <mxCell id="legendCard" value="&lt;b style='font-size:12px;color:#1E293B;'&gt;Key Architecture &amp;amp; Ethical Safeguards Highlights&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#475569;'&gt;&lt;b style='color:#0284C7;'&gt;1. 5-Agent Stateful Pipeline:&lt;/b&gt; Assessment &amp;rarr; Gap &amp;rarr; Tailor &amp;rarr; Staging &amp;rarr; Interview&lt;br&gt;&lt;b style='color:#7C3AED;'&gt;2. Production Tech Stack:&lt;/b&gt; FastAPI ASGI backend, Jinja2/Tailwind SPA, Motor MongoDB&lt;br&gt;&lt;b style='color:#DC2626;'&gt;3. Ethical HITL Gate (No Auto-Fill):&lt;/b&gt; Stages verified package, links to official portals, zero bot ban liability&lt;br&gt;&lt;b style='color:#059669;'&gt;4. Zero Hallucination Guardrail:&lt;/b&gt; Only transforms authentic projects into STAR metrics&lt;br&gt;&lt;b style='color:#D97706;'&gt;5. Auth &amp;amp; Save Enforcement:&lt;/b&gt; Free guest exploration; login with SHA-256 required to save info&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#F1F5F9;strokeColor=#CBD5E1;strokeWidth=1.5;align=left;verticalAlign=middle;spacingLeft=12;shadow=1;" vertex="1" parent="1">
