          <mxGeometry x="500" y="780" width="350" height="85" as="geometry" />
        </mxCell>

        <!-- Agent 4: Application Staging & Verification Agent -->
        <mxCell id="agent4" value="&lt;b style='font-size:13px;color:#0C4A6E;'&gt;Agent 4: Application Staging &amp;amp; Verification Agent&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:10px;color:#0369A1;'&gt;&amp;bull; Pre-fills Structured Application Summary Cards&lt;br&gt;&amp;bull; Resolves &amp;amp; Verifies Official Employer Portal URLs&lt;br&gt;&amp;bull; Formats 1-Click Application Package Bundle&lt;br&gt;&amp;bull; Halts for Mandatory Human Verification (HITL)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#F0F9FF;strokeColor=#0284C7;strokeWidth=2;align=left;verticalAlign=middle;spacingLeft=15;shadow=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="890" width="360" height="95" as="geometry" />
        </mxCell>

        <!-- HITL Gate -->
        <mxCell id="hitlGate" value="&lt;b style='font-size:11.5px;color:#991B1B;'&gt;Human-in-the-Loop&lt;br&gt;(HITL) Gate&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:9px;color:#B91C1C;'&gt;Human Reviews Staged Fields,&lt;br&gt;Downloads Resume, &amp;amp;&lt;br&gt;Verifies Portal URL&lt;br&gt;&lt;b&gt;[Strictly ToS Safe &amp;amp; Compliant]&lt;/b&gt;&lt;/span&gt;" style="shape=rhombus;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2.5;align=center;verticalAlign=middle;fontColor=#991B1B;shadow=1;" vertex="1" parent="1">
