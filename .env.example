# ============================================================
# CareerPilot AI — Environment Configuration
# ============================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Security & JWT
JWT_SECRET=careerpilot-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Leave blank or omit to use the built-in resilient local document store (Zero setup required!)
MONGODB_URI=
MONGODB_DB_NAME=careerpilot_db

# AI Provider Free-Tier Keys (Optional: deterministic NLP fallback active if blank)
# Google Gemini 1.5 Flash Free Tier
GEMINI_API_KEY=
# Groq Llama 3.3 70B Free Tier
GROQ_API_KEY=
# Preferred Provider: "gemini" | "groq" | "auto"
AI_PROVIDER=auto

# Browser Automation (Playwright)
# Set to false for interactive visual browser staging (Headed mode)
PLAYWRIGHT_HEADLESS=false
PLAYWRIGHT_TIMEOUT=30000

# External Signal APIs (Optional: public anonymous endpoints used if blank)
GITHUB_TOKEN=

